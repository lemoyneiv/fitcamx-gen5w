<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_dark">

    <!-- ================= LEFT M3 NAVIGATION RAIL / SIDEBAR ================= -->
    <LinearLayout
        android:id="@+id/layout_sidebar"
        android:layout_width="196dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_panel"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Logo / App Title (Tap to save screenshot to USB; Long-press for Advanced Options) -->
        <LinearLayout
            android:id="@+id/layout_logo_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clickable="true"
            android:longClickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FITCAMX"
                    android:textColor="@color/accent_blue"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_author_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="by lemoyneiv"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tonal Wi-Fi Status Card + Rescan Pill -->
        <LinearLayout
            android:id="@+id/layout_wifi_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_wifi_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_rescan"
                style="@style/M3PillButton"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="@string/btn_rescan"
                android:background="@color/bg_button"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Navigation Section Label -->
        <TextView
            android:id="@+id/tv_nav_section_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:text="VIEW MODE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- M3 Stadium Navigation Pills -->
        <Button
            android:id="@+id/btn_tab_live"
            style="@style/M3PillButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="left|center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/tab_live"
            android:background="@color/accent_blue"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tab_gallery"
            style="@style/M3PillButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="left|center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/tab_gallery"
            android:background="@color/bg_button"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- M3 Theme Switcher Pill (Tap to pick, Long-press to cycle) -->
        <Button
            android:id="@+id/btn_theme"
            style="@style/M3PillButton"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="6dp"
            android:text="● Ocean Blue"
            android:background="@color/bg_button"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Compact Side-by-Side System Action Pills (Log + Exit) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_export_log"
                style="@style/M3PillButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.05"
                android:layout_marginRight="5dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="Save Log"
                android:background="@color/bg_button"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_exit_app"
                style="@style/M3PillButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.95"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="@string/btn_exit"
                android:background="@color/accent_blue"
                android:textColor="#003258"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rounded Tonal Diagnostic Card at bottom of sidebar -->
        <LinearLayout
            android:id="@+id/layout_diag_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E242C"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tv_diag_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Initializing..."
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_diag_tap_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="Diagnostics ›"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle M3 Outline Hairline -->
    <View
        android:id="@+id/divider_sidebar"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- ================= MAIN CONTENT FRAME ================= -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ================= LIVE VIEW MODE ================= -->
        <LinearLayout
            android:id="@+id/layout_live_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Video Player Surface (100% Full Vertical Height; supports Single & Side-by-Side) -->
            <FrameLayout
                android:id="@+id/frame_live_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#000000">

                <LinearLayout
                    android:id="@+id/layout_live_split"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:background="#000000">

                    <!-- Left / Primary Fitcamx Pane -->
                    <FrameLayout
                        android:id="@+id/frame_live_front_pane"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#000000">

                        <!-- LibVLC Direct Hardware Accelerated Surface (Auto-scaled & Centered) -->
                        <SurfaceView
                            android:id="@+id/surface_live"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <!-- Stream Loading / Buffering Indicator -->
                        <ProgressBar
                            android:id="@+id/pb_live_loading"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_gravity="center"
                            android:visibility="visible" />
                    </FrameLayout>

                    <View
                        android:id="@+id/divider_oem_split"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider"
                        android:visibility="gone" />

                    <!-- Right / Fullscreen Car Backup Camera Pane (Opaque RDMA0 View) -->
                    <FrameLayout
                        android:id="@+id/frame_live_oem_pane"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#000000"
                        android:visibility="gone">

                        <fitcamx.app.OemRearView
                            android:id="@+id/view_oem_rear"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/tv_oem_pane_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|left"
                            android:layout_margin="12dp"
                            android:background="#CC10141A"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="BACKUP · LIVE"
                            android:textColor="#F2F5F9"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- M3 Pill Live Stream Badge -->
                <TextView
                    android:id="@+id/tv_stream_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|left"
                    android:layout_margin="12dp"
                    android:background="#CC10141A"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="FRONT · LIVE"
                    android:textColor="#F2F5F9"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <!-- M3 Error Container Pill REC Badge -->
                <TextView
                    android:id="@+id/tv_rec_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:layout_margin="12dp"
                    android:background="#93000A"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="● REC"
                    android:textColor="#FFDAD6"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </FrameLayout>

            <View
                android:id="@+id/divider_live_controls"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <!-- Right Camera Action Rail (M3 Filled, Tonal & Outlined Pills) -->
            <LinearLayout
                android:id="@+id/layout_live_controls"
                android:layout_width="154dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/bg_panel"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_cam_controls_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="4dp"
                    android:text="CAMERA"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Multi-Mode View Selector (Primary Filled Pill) -->
                <Button
                    android:id="@+id/btn_toggle_cam"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/accent_blue"
                    android:text="View: FRONT"
                    android:textColor="#003258"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <!-- Horizontal Mirror Toggle (Per-View Mode, Ideal for Rearview Mirroring) -->
                <Button
                    android:id="@+id/btn_mirror_live"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/bg_button"
                    android:text="Mirror: OFF"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Take Snapshot (Secondary Tonal Pill) -->
                <Button
                    android:id="@+id/btn_snapshot"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/bg_button"
                    android:text="@string/btn_snapshot"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Emergency Lock Clip (Tertiary Tonal Pill) -->
                <Button
                    android:id="@+id/btn_emergency_lock"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/accent_gold"
                    android:text="@string/btn_lock"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <!-- Mic Mute / Unmute -->
                <Button
                    android:id="@+id/btn_toggle_mic"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/bg_button"
                    android:text="@string/btn_mic"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Manual Record Toggle (Error Container Pill) -->
                <Button
                    android:id="@+id/btn_toggle_record"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/accent_red"
                    android:text="Stop Recording"
                    android:textColor="#FFDAD6"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Camera Recording Resolution Toggle (Outlined Pill) -->
                <Button
                    android:id="@+id/btn_camera_res"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/bg_button"
                    android:text="Rec: 4K UHD"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp" />

                <!-- Time Sync Button -->
                <Button
                    android:id="@+id/btn_sync_time"
                    style="@style/M3PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:background="@color/bg_button"
                    android:text="Sync Clock"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SD CARD FOOTAGE / GALLERY MODE ================= -->
        <LinearLayout
            android:id="@+id/layout_gallery_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Left: M3 Clips Browser Column (Collapsible) -->
            <LinearLayout
                android:id="@+id/layout_gallery_list_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.88"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@color/bg_panel">

                <!-- Title & Refresh Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_clip_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="SD Card (Loading...)"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_refresh_gallery"
                        style="@style/M3PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="Reload"
                        android:background="@color/bg_button"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- M3 Filter Chips Row (8dp radius) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_filter_all"
                        style="@style/M3PillButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="0.78"
                        android:layout_marginRight="4dp"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:background="@color/accent_blue"
                        android:text="✓ All"
                        android:textColor="#ffffff"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_front"
                        style="@style/M3PillButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="0.92"
                        android:layout_marginRight="4dp"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:background="@color/bg_button"
                        android:text="Front"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_rear"
                        style="@style/M3PillButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="0.86"
                        android:layout_marginRight="4dp"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:background="@color/bg_button"
                        android:text="Rear"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_locked"
                        style="@style/M3PillButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1.34"
                        android:layout_marginRight="4dp"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:background="@color/bg_button"
                        android:text="Emergency"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_photos"
                        style="@style/M3PillButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1.0"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:background="@color/bg_button"
                        android:text="Photos"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lv_clips"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="5dp"
                    android:listSelector="@android:color/transparent"
                    android:cacheColorHint="@android:color/transparent" />

                <TextView
                    android:id="@+id/tv_empty_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/no_clips"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/divider_gallery_columns"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <!-- Right: 100% FULL VERTICAL HEIGHT Video / Photo Viewport -->
            <FrameLayout
                android:id="@+id/frame_gallery_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.52"
                android:background="#000000"
                android:clickable="true">

                <!-- LibVLC Direct Hardware Accelerated Surface (Auto-scaled & Centered across full 630px height!) -->
                <SurfaceView
                    android:id="@+id/surface_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Still Photo Viewer (SD Card Snapshots across full 630px height!) -->
                <ImageView
                    android:id="@+id/iv_gallery_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pb_gallery_loading"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Floating Top M3 Smoked-Glass Pill Toolbar (Auto-hides during active video playback) -->
                <LinearLayout
                    android:id="@+id/layout_gallery_top_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="#CC10141A"
                    android:clickable="true"
                    android:visibility="visible">

                    <!-- Hide / Show List Toggle Pill -->
                    <Button
                        android:id="@+id/btn_toggle_gallery_list"
                        style="@style/M3PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_marginRight="10dp"
                        android:background="@color/accent_blue"
                        android:text="Hide List"
                        android:textColor="#ffffff"
                        android:textSize="12sp" />

                    <!-- Selected Clip Name -->
                    <TextView
                        android:id="@+id/tv_selected_clip_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select a clip to review"
                        android:textColor="#F2F5F9"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <!-- Playback Speed Selector Pill -->
                    <Button
                        android:id="@+id/btn_playback_rate"
                        style="@style/M3PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingLeft="11dp"
                        android:paddingRight="11dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="6dp"
                        android:background="@color/bg_button"
                        android:text="--"
                        android:enabled="false"
                        android:textColor="@color/accent_gold"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <!-- Play / Pause Pill -->
                    <Button
                        android:id="@+id/btn_play_clip"
                        style="@style/M3PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingLeft="13dp"
                        android:paddingRight="13dp"
                        android:layout_marginRight="6dp"
                        android:background="@color/bg_button"
                        android:text="Play"
                        android:textColor="#F2F5F9"
                        android:textSize="12sp" />

                    <!-- Save to USB Pill -->
                    <Button
                        android:id="@+id/btn_download_to_usb"
                        style="@style/M3PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingLeft="13dp"
                        android:paddingRight="13dp"
                        android:background="@color/accent_green"
                        android:text="@string/btn_download_usb"
                        android:textColor="#003258"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Floating Bottom M3 Smoked-Glass Scrub & Info Card (Auto-hides during active video playback) -->
                <LinearLayout
                    android:id="@+id/layout_gallery_seek_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    android:background="#CC10141A"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:clickable="true"
                    android:visibility="visible">

                    <!-- Scrubbing Row (Hidden when viewing Still Photos) -->
                    <LinearLayout
                        android:id="@+id/layout_seek_bar_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/sb_gallery_seek"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:minHeight="6dp"
                            android:maxHeight="6dp"
                            android:layout_weight="1"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:max="1000"
                            android:progress="0"
                            android:enabled="false" />

                        <TextView
                            android:id="@+id/tv_seek_position"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="0%"
                            android:textColor="#F2F5F9"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- M3 Rounded USB Transfer Progress Bar -->
                    <ProgressBar
                        android:id="@+id/pb_download_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:minHeight="6dp"
                        android:maxHeight="6dp"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Single-Line Clip Details + USB Status Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_clip_details"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="Tap any clip or photo to preview"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_download_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#6DD58C"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:layout_marginLeft="8dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_usb_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_marginLeft="10dp"
                            android:text="USB: Checking..."
                            android:textColor="#FFB951"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
