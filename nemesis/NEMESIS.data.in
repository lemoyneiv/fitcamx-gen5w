[nemesis]
version=1.1
id=@PACKAGE_ID@
name=@NAME@
type=application
package-version=@PACKAGE_VERSION@
short-desc="@SHORT_DESC@"
detailed-desc="@DETAILED_DESC@"
os="any"
models="any"
depends=""
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=fitcamx-root
kind=sh
path=bin/service.sh
uid=root
mode=background
